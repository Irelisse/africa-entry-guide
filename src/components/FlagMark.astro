---
interface Props {
  slug: string;
  name: string;
  code?: string;
  eager?: boolean;
  compact?: boolean;
}

const { slug, name, code, eager = false, compact = false } = Astro.props;
const base = import.meta.env.BASE_URL;

const remoteFlags: Record<string, string> = {
  'somaliland': 'https://commons.wikimedia.org/wiki/Special:Redirect/file/Flag_of_Somaliland.svg',
  'zanzibar': 'https://commons.wikimedia.org/wiki/Special:Redirect/file/Flag_of_Zanzibar.svg',
  'puntland': 'https://commons.wikimedia.org/wiki/Special:Redirect/file/Flag_of_Puntland.svg',
  'ascension-island': 'https://commons.wikimedia.org/wiki/Special:Redirect/file/Flag_of_Ascension_Island.svg',
  'tristan-da-cunha': 'https://commons.wikimedia.org/wiki/Special:Redirect/file/Flag_of_Tristan_da_Cunha.svg',
  'canary-islands': 'https://commons.wikimedia.org/wiki/Special:Redirect/file/Flag_of_Canary_Islands_%28official%29.svg',
  'ceuta': 'https://commons.wikimedia.org/wiki/Special:Redirect/file/Flag_of_Ceuta.svg',
  'melilla': 'https://commons.wikimedia.org/wiki/Special:Redirect/file/Flag_of_Melilla.svg',
  'madeira': 'https://commons.wikimedia.org/wiki/Special:Redirect/file/Flag_of_Madeira.svg',
};

const neutralSlugs = new Set(['bir-tawil', 'abyei', 'halaib-triangle', 'western-sahara']);
const remote = remoteFlags[slug];
const localCode = code && !['AC', 'TA', 'IC', 'EA'].includes(code.toUpperCase()) ? code.toLowerCase() : undefined;
const src = remote ?? (localCode ? `${base}flags/${localCode}.png` : undefined);
const isTaafChild = code?.toUpperCase() === 'TF' && slug !== 'taaf';
---

<div class:list={['flag-mark', compact && 'flag-mark--compact', !src && 'flag-mark--neutral']}>
  {src && !neutralSlugs.has(slug) ? (
    <img
      src={src}
      alt={`Флаг: ${name}`}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      referrerpolicy="no-referrer"
    />
  ) : (
    <div class="geo-mark" aria-label={`Нейтральный географический знак: ${name}`} role="img">
      <span class="geo-mark__cross" aria-hidden="true"></span>
      <span class="geo-mark__dot" aria-hidden="true"></span>
    </div>
  )}
  {isTaafChild && <span class="flag-mark__tag">TAAF</span>}
</div>
