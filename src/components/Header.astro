---
import { siteConfig } from '../data/site-config';
interface Props { overlay?: boolean }
const { overlay = false } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<header class:list={['site-header', overlay && 'site-header--overlay']}>
  <div class="shell header-inner">
    <a class="brand" href={base} aria-label={`${siteConfig.name} ${siteConfig.edition}: главная`}>
      <span class="brand-compass" aria-hidden="true"><i></i></span>
      <span class="brand-copy">
        <strong>{siteConfig.name}</strong>
        <small>{siteConfig.edition}</small>
      </span>
    </a>
    <nav class="header-nav" aria-label="Основная навигация">
      <a href={`${base}#about`}>О проекте</a>
      <a href={`${base}#directions`}>Направления</a>
    </nav>
  </div>
</header>
