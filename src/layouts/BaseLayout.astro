---
import Header from '../components/Header.astro';
import { siteConfig } from '../data/site-config';
import '../styles/global.css';
const { title, description = siteConfig.tagline, home = false } = Astro.props;
const pageTitle = title ? `${title} · ${siteConfig.name}` : `${siteConfig.name} — ${siteConfig.edition}`;
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#17382f" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600&family=Manrope:wght@400;500;600;700;800&display=swap&subset=cyrillic" rel="stylesheet" />
    <title>{pageTitle}</title>
  </head>
  <body class:list={[home && 'home-page']}>
    <a class="skip-link" href="#main">К содержанию</a>
    <Header overlay={home} />
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="shell footer-top">
        <div class="footer-identity">
          <a class="footer-brand" href={import.meta.env.BASE_URL}>{siteConfig.name}</a>
          <span class="footer-edition">{siteConfig.edition}</span>
          <p class="footer-tagline">{siteConfig.tagline}.</p>
          <p class="footer-authors">От авторов каналов <a href={siteConfig.authors[0].url} target="_blank" rel="noopener noreferrer"><strong>«{siteConfig.authors[0].name}»</strong></a> и <a href={siteConfig.authors[1].url} target="_blank" rel="noopener noreferrer"><strong>«{siteConfig.authors[1].name}»</strong></a>.</p>
        </div>
        <nav class="footer-nav" aria-label="Навигация в подвале">
          <a href={`${import.meta.env.BASE_URL}#about`}>О проекте</a>
          <a href={`${import.meta.env.BASE_URL}#directions`}>Направления</a>
        </nav>
      </div>
      <div class="shell footer-bottom">
        <p>{siteConfig.disclaimer}</p>
        <p>© 2026 «{siteConfig.name}»</p>
        <a href={`${import.meta.env.BASE_URL}credits/`}>Лицензии</a>
      </div>
    </footer>
  </body>
</html>
